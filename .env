# OpenRouteService API Key
# Get free key from: https://openrouteservice.org/
ORS_API_KEY=your_openrouteservice_api_key_here

# Gmail SMTP for SOS Emails
# Use App Password (not real password) from Google Account
GMAIL_USERNAME=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# App Config
APP_NAME=SecureRide
